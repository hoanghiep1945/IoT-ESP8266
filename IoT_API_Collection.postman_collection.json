        {
          "name": "POST - Đăng nhập (Login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin\",\n  \"password\": \"Lm8eCMdpG4DXB3tKhDHnjxa1\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "login"]
            },
            "description": "Đăng nhập hệ thống qua SQLite. Backend sẽ trả về Cookie phiên 'iot_session'."
          }
        },
        {
          "name": "GET - Thông tin tài khoản hiện tại (Auth Me)",
